# Temporium Hono API Environment Variables
# Copy this file to .dev.vars for local development

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=24h

# Blockchain Configuration
TEMPO_RPC_URL=https://rpc.testnet.tempo.xyz
PASSKEY_REGISTRY_ADDRESS=0x...

# Relayer Configuration (for sponsored passkey registration)
RELAYER_PRIVATE_KEY=0x...

# CORS Configuration
ALLOWED_ORIGINS=*
