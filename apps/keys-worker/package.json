{
  "name": "@tollr/keys-worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create tollr-passkeys",
    "db:migrate": "wrangler d1 execute tollr-passkeys --remote --file=./migrations/0002_kv_schema.sql",
    "db:migrate:local": "wrangler d1 execute tollr-passkeys --local --file=./migrations/0002_kv_schema.sql"
  },
  "dependencies": {
    "tempo.ts": "^0.10.5",
    "@remix-run/headers": "^0.17.2",
    "@remix-run/route-pattern": "^0.15.3",
    "@remix-run/session": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "wrangler": "^3.99.0",
    "typescript": "^5.7.2"
  }
}
