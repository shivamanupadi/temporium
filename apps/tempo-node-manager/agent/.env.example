# Tempo Node Manager - Environment Configuration

# Server port
PORT=9545

# JWT secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-here

# Path to store admin config (password hash)
CONFIG_PATH=/etc/tempo-node-manager/config.json

# Tempo Docker configuration
TEMPO_VERSION=0.7.2
TEMPO_DATA_DIR=/var/lib/tempo
TEMPO_HTTP_PORT=8545
TEMPO_P2P_PORT=30303
