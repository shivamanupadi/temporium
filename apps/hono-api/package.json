{
  "name": "hono-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --persist",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply temporium-db",
    "db:migrate:local": "wrangler d1 migrations apply temporium-db --local",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No lint configured'"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "tempo.ts": "^0.10.5",
    "viem": "^2.42.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20"
  }
}
