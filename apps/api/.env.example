# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temporium?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# Server
PORT=3001

# Blockchain Configuration (Tempo Testnet)
TEMPO_RPC_URL="https://rpc.testnet.tempo.xyz"
PASSKEY_REGISTRY_ADDRESS="0x..."  # Deploy PasskeyRegistry contract and set address

# Relayer (for sponsored passkey registration)
RELAYER_PRIVATE_KEY="0x..."  # Private key of funded relayer account

# Deployer/Owner (optional - for contract management)
DEPLOYER_PRIVATE_KEY="0x..."  # Private key of contract owner
