{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "PORT",
        "TEMPO_RPC_URL",
        "PASSKEY_REGISTRY_ADDRESS",
        "RELAYER_PRIVATE_KEY",
        "ALLOWED_ORIGINS",
        "VITE_API_URL",
        "VITE_GATEWAY_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "PORT",
        "TEMPO_RPC_URL",
        "PASSKEY_REGISTRY_ADDRESS",
        "RELAYER_PRIVATE_KEY",
        "ALLOWED_ORIGINS",
        "VITE_API_URL",
        "VITE_GATEWAY_URL"
      ]
    },
    "start": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "PORT"
      ]
    },
    "start:prod": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "PORT"
      ]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
