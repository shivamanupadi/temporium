{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "VITE_API_URL",
        "VITE_TEMPO_NETWORK",
        "VITE_WALLET_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "JWT_SECRET",
        "JWT_EXPIRATION",
        "VITE_API_URL",
        "VITE_TEMPO_NETWORK",
        "VITE_WALLET_URL"
      ]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
