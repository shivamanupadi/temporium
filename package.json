{
  "name": "temporium",
  "private": true,
  "version": "0.0.1",
  "packageManager": "yarn@1.22.22",
  "description": "Tempo Gateway - Payments-first gateway for Tempo blockchain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo lint",
    "type-check": "turbo run type-check",
    "clean": "turbo clean && rimraf node_modules .turbo dist yarn.lock",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "reset": "yarn clean && yarn install",
    "check:push": "yarn lint && yarn build",
    "kill-ports": "lsof -ti:3000,3001 | xargs kill -9 || true"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "turbo": "^2.5.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
