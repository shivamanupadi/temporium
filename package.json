{
  "name": "temporium",
  "private": true,
  "version": "0.0.1",
  "packageManager": "yarn@1.22.22",
  "description": "Tempo Gateway - Payments-first gateway for Tempo blockchain",
  "workspaces": [
    "apps/home",
    "apps/gateway",
    "apps/gateway/*",
    "apps/node-manager",
    "apps/node-manager/api",
    "apps/node-manager/web",
    "apps/node-manager/home",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo lint",
    "type-check": "turbo run type-check",
    "clean": "turbo clean && rimraf node_modules .turbo dist yarn.lock '**/node_modules' '**/dist' '**/.turbo' '**/.vite' '**/.wrangler' '**/contracts/out' '**/contracts/cache' '**/contracts/broadcast'",
    "format": "turbo run format",
    "reset": "yarn clean && yarn install",
    "check:push": "yarn lint && yarn build",
    "kill-ports": "lsof -ti:4000,4001,4002,4005,4006,4007 | xargs kill -9 || true",
    "dev:gateway": "turbo run dev --filter=@temporium/gateway",
    "dev:node-manager": "turbo run dev --filter=@temporium/node-manager",
    "build:gateway": "turbo run build --filter=@temporium/gateway",
    "build:node-manager": "turbo run build --filter=@temporium/node-manager",
    "postinstall": "patch-package && node scripts/patch-ox.js"
  },
  "devDependencies": {
    "patch-package": "^8.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "turbo": "^2.5.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
